<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>infrabot_bringup</name>
  <version>0.1.1</version>
  <description>Launch files, ros2_control URDF and controller configuration for the InfraBot H7C arm.</description>
  <maintainer email="dong1505lin@gmail.com">YaolinDong</maintainer>
  <author email="dong1505lin@gmail.com">YaolinDong</author>
  <license file="../LICENSE">Apache-2.0</license>
  <url type="repository">https://github.com/YaolinDong/infrabot-ros2</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>infrabot_description</exec_depend>
  <exec_depend>infrabot_hardware</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>hardware_interface</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>forward_command_controller</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_cmake_ros</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>controller_manager_msgs</test_depend>
  <test_depend>control_msgs</test_depend>
  <test_depend>trajectory_msgs</test_depend>
  <test_depend>builtin_interfaces</test_depend>
  <test_depend>sensor_msgs</test_depend>
  <test_depend>rclpy</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
