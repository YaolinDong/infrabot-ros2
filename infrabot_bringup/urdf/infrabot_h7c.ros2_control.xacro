<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- J1-J7 limits follow infrabot_description (rad). -->
  <xacro:macro name="infrabot_h7c_joint" params="index lower upper">
    <joint name="Joint_${index}">
      <command_interface name="position">
        <param name="min">${lower}</param>
        <param name="max">${upper}</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="infrabot_h7c_ros2_control"
               params="name robot_ip use_mock_hardware telemetry_timeout_ms:=100 command_timeout_ms:=100">
    <ros2_control name="${name}" type="system">
      <hardware>
        <xacro:if value="${use_mock_hardware}">
          <plugin>mock_components/GenericSystem</plugin>
        </xacro:if>
        <xacro:unless value="${use_mock_hardware}">
          <plugin>infrabot_hardware/InfrabotSystem</plugin>
          <param name="robot_ip">${robot_ip}</param>
          <param name="telemetry_timeout_ms">${telemetry_timeout_ms}</param>
          <param name="command_timeout_ms">${command_timeout_ms}</param>
        </xacro:unless>
      </hardware>
      <xacro:infrabot_h7c_joint index="1" lower="-2.8" upper="2.8"/>
      <xacro:infrabot_h7c_joint index="2" lower="0.0" upper="3.14"/>
      <xacro:infrabot_h7c_joint index="3" lower="-2.8" upper="2.8"/>
      <xacro:infrabot_h7c_joint index="4" lower="0.0" upper="3.14"/>
      <xacro:infrabot_h7c_joint index="5" lower="-2.8" upper="2.8"/>
      <xacro:infrabot_h7c_joint index="6" lower="-2.0" upper="2.0"/>
      <xacro:infrabot_h7c_joint index="7" lower="-1.8" upper="1.8"/>
    </ros2_control>
  </xacro:macro>
</robot>
